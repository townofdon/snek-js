<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" type="text/css" href="../style.css">

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Monofett&family=VT323&display=swap" rel="stylesheet">

    <meta charset="utf-8" />
    <title>SNEK::LevelPreviewGen</title>
    <link rel="icon" type="image/png" href="assets/graphics/snek-favicon.png">

    <%= htmlWebpackPlugin
      .tags
      .headTags
      .filter((tag) => tag.attributes?.src?.includes('levelPreviewGen.bundle'))
      .join('')
    %>
    <style>
      document, body {
        background: #111;
        color: #eee;
      }
    </style>
  </head>
  <body>
    <div id="level-preview-gen-root">
    </div>
  </body>
</html>
