<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" type="text/css" href="./style.css">

    <!-- google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Monofett&family=VT323&display=swap" rel="stylesheet">

    <!-- social media embeds -->
    <meta property="og:title" content="SNEK" />
    <meta property="og:site_name" content="SNEK" />
    <meta property="og:type" content="game" />
    <meta property="og:description" content="The classic survival game, reimagined with 20+ levels and a bumpin' chiptune original soundtrack" />
    <meta property="og:url" content="https://townofdon.github.io/snek-js/" />
    <meta property="og:image" content="https://townofdon.github.io/snek-js/readme/promo-snek-card.png" />

    <meta name="twitter:title" content="SNEK">
    <meta name="twitter:description" content="The classic survival game, reimagined with 20+ levels and a bumpin' chiptune original soundtrack">
    <meta name="twitter:image" content="https://townofdon.github.io/snek-js/readme/promo-snek-card.png">
    <meta name="twitter:card" content="summary_large_image">

    <meta charset="utf-8" />
    <title>SNEK</title>
    <link rel="icon" type="image/png" href="assets/graphics/snek-favicon.png">

    <%= htmlWebpackPlugin
      .tags
      .headTags
      .filter((tag) =>
        tag.attributes?.src?.includes('main.bundle') ||
        /main.*\.css$/.test(tag.attributes?.href)
      )
      .join('')
    %>
  </head>
  <body>
    <div class="center stretch overflow-hidden">
      <main id="main">

        <div id="game" class="game">
          <canvas id="ui-canvas-left" class="ui-canvas-left" style="width: 20px; height: 960px;" width="20" height="960"></canvas>
          <canvas id="ui-canvas-right" class="ui-canvas-right" style="width: 20px; height: 960px;" width="20" height="960"></canvas>
          <div id="game-container" class="containment">
            <canvas id="game-canvas" class="p5Canvas" style="width: 960px; height: 960px;" width="960" height="960"></canvas>
            <div id="main-menu-v2" class="position-absolute stretch">
              <!-- React UI V2 -->
            </div>
            <div id="debug-menu-v2" class="position-absolute stretch">
              <!-- React UI V2 -->
            </div>
          </div><!-- /.containment -->
    
        </div><!-- /.game -->

        <div id="settings-menu-v2" class="position-absolute fill">
          <!-- React UI V2 -->
        </div>

        <div id="select-game-mode-menu" class="settings-menu hidden">
          <div class="background blur"></div>
          <div class="content gap">
            <h2>Game Mode</h2>
            <button id="button-game-mode-campaign" class="button newbutton ui-arrows select-white game-mode campaign">campaign</button>
            <button id="button-game-mode-challenge" class="button newbutton ui-arrows select-white game-mode challenge">challenge</button>
            <button id="button-game-mode-level-select" class="button newbutton ui-arrows select-white game-mode level-select">level select</button>
            <button id="button-game-mode-randomizer" class="button newbutton ui-arrows select-white game-mode randomizer">randomizer</button>
            <button id="button-game-mode-back" class="button newbutton ui-arrows select-white game-mode back">&lt;- back</button>
          </div>
        </div>

        <div id="start-screen" class="start-screen" style="width: 960px; height: 960px;" width="960" height="960">
          <img alt="SNEK" class="start-screen-title" src="assets/graphics/snek-title-red-sm.png" width="614.4" height="204.8" />
          <button id="start-screen-start-button" class="start">start game</button>
          <p class="press-enter"><span>[ PRESS ENTER ]</span></p>
        </div>

        <div id="modal-highscore-entry" class="modal hidden">
          <form id="form-highscore-entry" action="javascript:void(0);" autocomplete="off">
            <h2 class="center">High Score Earned!</h2>
            <p class="center"><strong><label for="input-highscore-name">ENTER SNEK CHAMPION NAME</label></strong></p>
            <div class="center">
              <input type="text" id="input-highscore-name" name="input-highscore-name" maxlength="20" autocomplete="off" pattern="^([A-Za-z0-9_-]|\s)+$"  />
            </div>
            <p class="minimood center">[Enter] To Submit</p>
            <p class="center hidden">
              <button type="submit" class="button">SUBMIT</button>
            </p>
          </form>
        </div>

        <div id="modal" class="modal hidden">
          <form id="modal-form" action="javascript:void(0);">
            <h2 id="modal-title" class="center">CONFIRM</h2>
            <p id="modal-message" class="minimood">&lt;Modal Title&gt;</p>
            <p class="center buttons">
              <button id="modal-button-no" class="button" type="submit" value="no">NO</button>
              <button id="modal-button-yes" class="button" type="submit" value="yes">YES</button>
            </p>
          </form>
        </div>

        <div id="level-select-menu-v2" class="position-absolute fill">
          <!-- React UI V2 -->
        </div>

        <!-- TODO: REMOVE THIS -->
        <!-- <div id="level-select-menu" class="settings-menu level-select-menu hidden">
           <div id="button-level-select-back"></div>
           <div id="level-select-challenge-heading"></div>
           <div id="level-select-map-number"></div>
           <div id="level-select-map-name"></div>
           <div id="level-select-levels"></div>
        </div> -->

        <div id="loader" class="loader-container hidden"><span class="loader"></span></div>

      </main>

      <div id="compressor-controls" class="compressor-controls hidden">
        <h3 class="fullwidth center minimood">Compressor</h3>
        <label id="compressor-attack">
          <span>attack</span>
          <input type="number" name="attack" value=".005" />
          <input type="range" name="attack" min="0" max="1" step="0.001" value=".005" />
        </label>
        <label id="compressor-knee">
          <span>knee</span>
          <input type="number" name="knee" value="30" />
          <input type="range" name="knee" min="0" max="60" step="0.1" value="30" />
        </label>
        <label id="compressor-ratio">
          <span>ratio</span>
          <input type="number" name="ratio" value="12" />
          <input type="range" name="ratio" min="0" max="24" step="0.1" value="12" />
        </label>
        <label id="compressor-release">
          <span>release</span>
          <input type="number" name="release" value="0.250" />
          <input type="range" name="release" min="0" max="4" step="0.001" value="0.250" />
        </label>
        <label id="compressor-threshold">
          <span>threshold</span>
          <input type="number" name="threshold" value="-24" />
          <input type="range" name="threshold" min="-60" max="0" step="0.1" value="-24" />
        </label>

        <h3 class="fullwidth center minimood">EQ</h3>

        <label id="eq-low-freq">
          <span>low-freq</span>
          <input type="number" name="low-freq" value="200" />
          <input type="range" name="low-freq" min="20" max="20000" step="1" value="200" />
        </label>
        <label id="eq-low-gain">
          <span>low-gain</span>
          <input type="number" name="low-gain" value="0" />
          <input type="range" name="low-gain" min="-20" max="20" step="0.1" value="0" />
        </label>
        <label id="eq-mid-freq">
          <span>mid-freq</span>
          <input type="number" name="mid-freq" value="800" />
          <input type="range" name="mid-freq" min="20" max="20000" step="1" value="800" />
        </label>
        <label id="eq-mid-gain">
          <span>mid-gain</span>
          <input type="number" name="mid-gain" value="0" />
          <input type="range" name="mid-gain" min="-20" max="20" step="0.1" value="0" />
        </label>
        <label id="eq-hi-freq">
          <span>hi-freq</span>
          <input type="number" name="hi-freq" value="8000" />
          <input type="range" name="hi-freq" min="20" max="20000" step="1" value="8000" />
        </label>
        <label id="eq-hi-gain">
          <span>hi-gain</span>
          <input type="number" name="hi-gain" value="0" />
          <input type="range" name="hi-gain" min="-20" max="20" step="0.1" value="0" />
        </label>
      </div>
    </div>
  </body>
</html>
