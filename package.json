{
  "name": "snekjs",
  "version": "1.28.3",
  "description": "snake game made with p5.js",
  "private": true,
  "scripts": {
    "start": "npm run dev",
    "dev": "http-server ./dist -p 3000 -c-1",
    "serve-prod": "http-server ./dist-prod -p 3000 -c-1",
    "test": "NODE_ENV=test mocha --require mochaSetup.cjs -r ts-node/register -r tsconfig-paths/register 'src/**/*test.ts'",
    "build": "NODE_ENV=production webpack --mode=production --config-node-env=production",
    "build-dev": "NODE_ENV=development webpack --mode=development --config-node-env=development",
    "deploy": "echo \"Don't forget to bump the version!\n\" && git push --tags",
    "deploy-gh-pages": "echo \"Deprecated: run 'npm run deploy'\" && exit 1",
    "deploy-prod-manual": "npm run build && cd bin && ./deploy.sh",
    "bundle": "cd bin && ./bundle.sh",
    "watch": "NODE_ENV=development webpack --watch --config-node-env=development"
  },
  "browser": {
    "crypto": false
  },
  "author": "townofdon",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "color": "^4.2.3",
    "eventemitter3": "^5.0.1",
    "expect": "^29.7.0",
    "format-number": "^3.0.0",
    "p5": "^1.11.11",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-paginate": "^8.2.0",
    "react-query": "^3.39.3",
    "react-select": "^5.8.0",
    "react-share": "^5.1.0",
    "react-toggle": "^4.1.3",
    "throttleit": "^2.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@fal-works/eslint-config-p5js": "^1.0.3",
    "@types/color": "^3.0.4",
    "@types/mocha": "^10.0.6",
    "@types/node": "^25.5.0",
    "@types/p5": "^1.7.7",
    "@types/react-toggle": "^4.0.5",
    "@types/throttleit": "^1.0.2",
    "@types/uuid": "^9.0.7",
    "@webpack-cli/generators": "^3.0.7",
    "assert": "^2.1.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^8.50.0",
    "html-webpack-plugin": "^5.6.6",
    "http-server": "^14.1.1",
    "jsdom": "24.0.0",
    "jsdom-global": "3.0.2",
    "mini-css-extract-plugin": "^2.10.2",
    "mocha": "^12.0.0-beta-10",
    "nw-builder": "^4.17.7",
    "sass": "^1.98.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  }
}
